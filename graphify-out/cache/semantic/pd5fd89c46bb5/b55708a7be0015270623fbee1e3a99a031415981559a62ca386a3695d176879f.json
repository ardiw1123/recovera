{"nodes": [{"id": "agents_skills_supabase_postgres_best_practices_references_schema_foreign_key_indexes_foreign_key_index", "label": "Foreign Key Index", "file_type": "document", "source_file": ".agents/skills/supabase-postgres-best-practices/references/schema-foreign-key-indexes.md", "rationale": "Postgres does not automatically index foreign key columns; missing indexes cause slow JOINs and ON DELETE CASCADE operations requiring full table scans. Always index the FK (referencing) column."}, {"id": "agents_skills_supabase_postgres_best_practices_references_schema_foreign_key_indexes_cascade", "label": "ON DELETE CASCADE", "file_type": "concept", "source_file": ".agents/skills/supabase-postgres-best-practices/references/schema-foreign-key-indexes.md"}, {"id": "agents_skills_supabase_postgres_best_practices_references_schema_foreign_key_indexes_foreign_keys_docs", "label": "PostgreSQL Foreign Keys documentation", "file_type": "document", "source_file": ".agents/skills/supabase-postgres-best-practices/references/schema-foreign-key-indexes.md"}], "edges": [{"source": "agents_skills_supabase_postgres_best_practices_references_schema_foreign_key_indexes_foreign_key_index", "target": "agents_skills_supabase_postgres_best_practices_references_schema_foreign_key_indexes_cascade", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase-postgres-best-practices/references/schema-foreign-key-indexes.md"}, {"source": "agents_skills_supabase_postgres_best_practices_references_schema_foreign_key_indexes_foreign_key_index", "target": "agents_skills_supabase_postgres_best_practices_references_schema_foreign_key_indexes_foreign_keys_docs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase-postgres-best-practices/references/schema-foreign-key-indexes.md"}], "hyperedges": []}