# App Configuration
APP_NAME=Recovera API
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security
SECRET_KEY=recovera-super-secret-development-key-change-in-production-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (defaults to local SQLite if unset, uses PostgreSQL in Docker/production)
# SQLite for local: sqlite:///./recovera.db
# PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/recovera
DATABASE_URL=sqlite:///./recovera.db

# CORS (comma-separated origins)
CORS_ORIGINS=*

# Optional external service credentials
GEMINI_API_KEY=
CLOUDINARY_URL=
FCM_SERVER_KEY=
WEB3_RPC_URL=https://rpc.bot-chain.testnet
