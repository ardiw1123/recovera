# App Configuration
APP_NAME=Recovera API
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security
SECRET_KEY=recovera-super-secret-development-key-change-in-production-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (defaults to local SQLite if unset, uses PostgreSQL in Docker/production)
# SQLite for local: sqlite:///./recovera.db
# PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/recovera
DATABASE_URL=sqlite:///./recovera.db

# CORS (comma-separated origins)
CORS_ORIGINS=*

# Optional external service credentials
GEMINI_API_KEY=
# Supabase Dashboard > Project Settings > API > Project URL
SUPABASE_URL=
# Server-only secret API key. Legacy SUPABASE_SERVICE_ROLE_KEY is also accepted.
SUPABASE_SECRET_KEY=
# Create this as a public bucket in Supabase Storage.
SUPABASE_STORAGE_BUCKET=product-images
# Path to the Firebase Admin SDK JSON file; keep the file in backend/secrets/ or outside the repo.
FIREBASE_CREDENTIALS_PATH=secrets/firebase-admin.json
# On Railway, paste the full JSON into this variable instead of deploying a credential file.
FIREBASE_CREDENTIALS_JSON=

# WEB3_RPC_URL deprecated; using BOT_CHAIN_RPC_URL

# Blockchain BOT Chain Configuration
BOT_CHAIN_RPC_URL=https://rpc.bohr.life
BOT_CHAIN_CHAIN_ID=968
BOT_CHAIN_PRIVATE_KEY=
BOT_CHAIN_CONTRACT_ADDRESS=
BOT_CHAIN_EXPLORER_URL=https://scan.bohr.life/
